<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseWeapon">
    <defName>Weapon_CatLauncher</defName><label>cat launcher</label><description>A long-range launcher that fires rotating cat shells.</description>
    <graphicData><texPath>Things/Item/Equipment/WeaponRanged/CatLauncher</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <techLevel>Industrial</techLevel><statBases><Mass>3</Mass><RangedWeapon_Cooldown>3</RangedWeapon_Cooldown><WorkToMake>16000</WorkToMake></statBases>
    <costList><Steel>80</Steel><ComponentIndustrial>4</ComponentIndustrial><Chemfuel>50</Chemfuel></costList>
    <recipeMaker><researchPrerequisite>Machining</researchPrerequisite></recipeMaker>
    <verbs><li><label>launch cat</label><verbClass>Verb_LaunchProjectile</verbClass><hasStandardCommand>true</hasStandardCommand><range>24</range><forcedMissRadius>1.9</forcedMissRadius><warmupTime>2.5</warmupTime><noiseRadius>4</noiseRadius><targetParams><canTargetLocations>true</canTargetLocations></targetParams><defaultProjectile>Projectile_CatShell</defaultProjectile></li></verbs>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
